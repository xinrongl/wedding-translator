# GCP
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=australia-southeast2
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=false

# Service Deployment
SERVICE_NAME=wedding-translator

# Gemini Models (Two-Step Live Architecture)
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live-preview
TRANSLATION_MODEL=gemini-3.5-flash
SOURCE_LANGUAGE_DESCRIPTION=Mandarin Chinese (Simplified) with mixed English code-switching
TARGET_LANGUAGE=en
ENABLE_LIVE_AUDIO_STREAM=false


# Speech-to-Text
STT_LANGUAGE_CODES=zh-CN,en-US
STT_MODE=SMART
TEMPERATURE=0.2

# Wedding Context
WEDDING_BRIDE_NAME=Joy
WEDDING_GROOM_NAME=Xinrong
WEDDING_VENUE=Stones of the Yarra Valley
WEDDING_CUSTOM_NOTES=
WEDDING_CUSTOM_VOCABULARY="Joy,Xinrong,顺顺,赵雪,林欣荣"

# Runtime
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
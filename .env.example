# GCP Configuration
# For Accenture environment:
#   GOOGLE_CLOUD_PROJECT=ktzdeir-agbg-anz-gemini-vertex
#   GOOGLE_GENAI_USE_VERTEXAI=true
# For Personal environment:
#   GOOGLE_CLOUD_PROJECT=canvas-aviary-302803
#   GOOGLE_GENAI_USE_VERTEXAI=false
#   GEMINI_API_KEY=AIzaSy...
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=australia-southeast2
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY=

# Service Deployment
SERVICE_NAME=wedding-translator

# Access Control (Sign in with Google to open /ws/speaker; guests never need this)
# Create an OAuth 2.0 Web Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your deployed URL (and http://localhost:5173 for dev)
GOOGLE_OAUTH_CLIENT_ID=
SPEAKER_ALLOWED_EMAILS=405896828.xl@gmail.com

# Gemini Live 1-Step simultaneous translation (served from location 'global' on Vertex)
LIVE_MODEL=gemini-3.5-live-translate-preview
# Text model that polishes each subtitle's English with context and the names below (empty = Live English only)
REFINE_MODEL=gemini-3.5-flash
SOURCE_LANGUAGE_DESCRIPTION=Mandarin Chinese (Simplified) with mixed English code-switching
TARGET_LANGUAGE=en

# Wedding Context
WEDDING_BRIDE_NAME=Joy
WEDDING_GROOM_NAME=Xinrong
WEDDING_VENUE=Stones of the Yarra Valley
WEDDING_CUSTOM_NOTES=

# Runtime
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO